# Copy to .env.local and fill in your values.
# These are baked into the Vite build at deploy time — never commit .env.local.

# EmailJS (https://emailjs.com) — Service ID, Template ID, Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Anthropic API key for client-side AI narrative
# (set as a GitHub repo secret for production — never commit this)
VITE_ANTHROPIC_API_KEY=
